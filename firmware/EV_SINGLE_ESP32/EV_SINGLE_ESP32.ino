// ===========================================================================
DHT dht(DHT_PIN, DHT11);
OneWire oneWire(ONE_WIRE_BUS);
DallasTemperature tempSensors(&oneWire);
Adafruit_ADS1115 ads;
bool ads_ok = false;

WiFiClient   net;
PubSubClient mqtt(net);

static StaticJsonDocument<2048> outDoc;
static char outBuf[2048];

// ===========================================================================
//  5. STATE
// ===========================================================================
struct BatteryState {
  float cell_temp[CELL_COUNT];
  float ambient_temp, ambient_humidity;
  float cell_voltage[CELL_COUNT];
  float pack_voltage;
  float current_A;
  float power_W;
  float soc_percent;
  float soh_percent;
  float rul_cycles;
  float piezo_raw[2];
  int   gas_level;
  float cell_imbalance;
  float thermal_gradient_C;
  float dT_dt;
  int   cycles_completed;
  bool  fault_ov, fault_uv, fault_ot, fault_gas;
  float r0_mohm;
  float dod_percent;
  float soe_percent, sof_percent, sop_percent;
  float continuous_current_limit_A;
  float peak_discharge_current_limit_A;
  float peak_charge_current_limit_A;
  float thermal_runaway_risk;
  float remaining_energy_Wh;
  float total_energy_throughput_Wh;
  float equivalent_full_cycles;
  float time_to_empty_min, time_to_full_min;
  int   target_current;
  int   pwm_duty;
  bool  bms_tripped;
} bat;

// Globals
float coulomb_mAh = 0.0f;
float cycle_discharge_mAh = 0.0f;
float baseline_capacity_mAh = PACK_CAPACITY_MAH;
float measured_capacity_mAh = PACK_CAPACITY_MAH;
float acs712_zero_volts = 2.5f;
float target_current_A = 0.0f;
int   pwm_duty = 0;
int   fan_duty = 0;
bool  safety_active = false;
char  safety_reason[64] = "";

float last_max_temp = 0.0f;
unsigned long last_temp_time = 0;
bool thermal_seeded = false;

float prev_current_A = 0.0f;
float prev_pack_voltage = 0.0f;
bool  r0_seeded = false;

unsigned long last_sensor_ms = 0;
unsigned long last_control_ms = 0;
unsigned long lastMqttTry = 0;
unsigned long lastStats = 0;

char        warnBuf[320];
int         statusLevel = 0;
const char* statusText  = "NORMAL";

char usb_cmd_buf[96];
uint8_t usb_cmd_len = 0;

// ---- REV B: two-way control ----
float current_limit_A = 5.0f;          // cap set by the digital twin (LIMIT:)
int   fan_override_pct = -1;           // -1 = automatic temperature curve
float sensor_dt_s = 1.0f;              // measured time between sensor passes
unsigned long prev_sensor_pass_ms = 0;

// ---- REV B: demo mode ----
bool  demo_mode = false;
unsigned long last_demo_msg_ms = 0;
#define DEMO_TIMEOUT_MS 30000UL

// ---- REV B: edge AI (one discharge being averaged) ----
#define AI_DISCHARGE_A      0.3f
#define AI_QUIET_READINGS   3
#define AI_MIN_REAL_MS      300000UL   // real pack: 5 minutes
#define AI_MIN_REPLAY_MS    4000UL     // replayed lab cycles are compressed
