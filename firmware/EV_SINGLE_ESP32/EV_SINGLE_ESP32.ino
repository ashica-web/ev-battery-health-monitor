void publishState() {
  if (!mqtt.connected()) return;   // skip publish only — calc/print already happened
  if (demo_mode) return;           // REV B: the laptop's replay owns battery/state now

  size_t n = serializeJson(outDoc, outBuf, sizeof(outBuf));
  if (n == 0 || n >= sizeof(outBuf)) {
    Serial.println(F("[MQTT] serialize overflow — state not sent"));
    return;
  }
  if (!mqtt.publish("battery/state", outBuf, true)) {
    Serial.printf("[MQTT] state publish FAILED (%u bytes)\n", (unsigned)n);
    return;
  }

  mqtt.publish("battery/alert/status",   statusText, true);
  mqtt.publish("battery/alert/level",    String(statusLevel).c_str(), true);
  mqtt.publish("battery/alert/warnings", warnBuf, true);
  mqtt.publish("battery/pack_voltage", String(bat.pack_voltage, 3).c_str());
  mqtt.publish("battery/current_A",    String(bat.current_A, 3).c_str());
  mqtt.publish("battery/soc_percent",  String(bat.soc_percent, 1).c_str());
  mqtt.publish("battery/soh_percent",  String(bat.soh_percent, 1).c_str());
  mqtt.publish("battery/temp/cell1",   String(bat.cell_temp[0], 2).c_str());
  mqtt.publish("battery/temp/cell2",   String(bat.cell_temp[1], 2).c_str());
  mqtt.publish("battery/temp/cell3",   String(bat.cell_temp[2], 2).c_str());
  mqtt.publish("battery/fan_duty",     String(fan_duty).c_str());
}

// ===========================================================================
//  16. PRINT — unconditional, every second, regardless of MQTT state
// ===========================================================================
void printState() {
  Serial.println(F("\n================ BATTERY STATE ================"));
  Serial.printf("TEMP: %.1f %.1f %.1f C | Ambient %.1f C / %.1f %%RH\n",
                bat.cell_temp[0], bat.cell_temp[1], bat.cell_temp[2], bat.ambient_temp, bat.ambient_humidity);
  Serial.printf("V: %.3f %.3f %.3f | PACK %.3f V\n", bat.cell_voltage[0], bat.cell_voltage[1], bat.cell_voltage[2], bat.pack_voltage);
  Serial.printf("I: %.3f A | Target %.2f A | Load PWM %d | Fan PWM %d/%d\n",
                bat.current_A, target_current_A, pwm_duty, fan_duty, FAN_PWM_MAX);
  Serial.printf("SOC %.1f%% | SOH %.1f%% | RUL %.1f cycles\n", bat.soc_percent, bat.soh_percent, bat.rul_cycles);
  Serial.printf("SOE %.1f%% | SOF %.1f%% | SOP %.1f%%\n", bat.soe_percent, bat.sof_percent, bat.sop_percent);
  Serial.printf("R0 %.1f mOhm | Imbalance %.3f V | Thermal gradient %.2f C\n", bat.r0_mohm, bat.cell_imbalance, bat.thermal_gradient_C);
  Serial.printf("Thermal risk %.1f/100 | dT/dt %.3f C/s\n", bat.thermal_runaway_risk, bat.dT_dt);
  Serial.printf("Piezo: %d %d | Gas: %d\n", (int)bat.piezo_raw[0], (int)bat.piezo_raw[1], bat.gas_level);
  Serial.printf("Status: %s | Warnings: %s\n", statusText, warnBuf);
  if (safety_active) Serial.printf("SAFETY CUTOFF ACTIVE: %s\n", safety_reason);
  if (!ads_ok) Serial.println(F("WARNING: ADS1115 not detected — voltages are stale/zero"));
  if (current_limit_A < 5.0f) Serial.printf("TWIN CURRENT LIMIT: %.2f A\n", current_limit_A);
  if (demo_mode) Serial.println(F("[DEMO MODE] own readings NOT published - on-chip AI runs on laptop replay"));
  if (dis.active) Serial.printf("[EDGE AI] averaging discharge: %lu s so far\n", (millis() - dis.start_ms) / 1000);
  Serial.printf("[MQTT] %s\n", mqtt.connected() ? "connected, published above" : "NOT connected — readings still logged locally");
  Serial.println(F("=================================================\n"));
}

// ===========================================================================
//  17. SETUP
// ===========================================================================
void setup() {
  Serial.begin(115200);
  delay(500);
  Serial.println(F("\n===== EV BATTERY MONITOR — SINGLE ESP32 ====="));
  Serial.printf("Firmware: %s\n", FW_TAG);

  analogReadResolution(12);
  analogSetAttenuation(ADC_11db);

  Wire.begin(ADS1115_SDA, ADS1115_SCL);
  if (ads.begin(ADS1115_I2C_ADDR)) {
    ads.setGain(ADS_GAIN);
    ads.setDataRate(RATE_ADS1115_860SPS);   // REV B: fast reads (8 samples ~10 ms)
    ads_ok = true;
    Serial.println(F("ADS1115 found and configured (GAIN_ONE, +-4.096V)"));
  } else {
    ads_ok = false;
    Serial.println(F("ADS1115 NOT FOUND on I2C (SDA21/SCL22, addr 0x48) — check wiring"));
  }

  tempSensors.begin();
  Serial.printf("DS18B20 found: %d\n", tempSensors.getDeviceCount());

  dht.begin();

  ledcAttach(MOSFET_PWM_PIN, LOAD_PWM_FREQ, LOAD_PWM_RES_BITS);
  ledcWrite(MOSFET_PWM_PIN, 0);
  Serial.println(F("MOSFET load PWM on GPIO13, load OFF"));

  ledcAttach(FAN_PWM_PIN, FAN_PWM_FREQ, FAN_PWM_RES_BITS);
  ledcWrite(FAN_PWM_PIN, 0);
  Serial.println(F("Fan PWM on GPIO25, off"));

  Serial.println(F("Calibrating ACS712..."));
  delay(1500);
  calibrateCurrentZero();
  Serial.printf("ACS712 zero = %.4f V\n", acs712_zero_volts);
  Serial.printf("Current sensor read via %s\n", CURRENT_VIA_ADS ? "ADS1115 A3 (16-bit)" : "ESP32 ADC GPIO35");

  aiSelfTest();                       // REV B

  connectWiFi();
  mqtt.setServer(MQTT_HOST, MQTT_PORT);
  mqtt.setCallback(onMqttMessage);
  mqtt.setBufferSize(4096);
  mqtt.setKeepAlive(30);

  Serial.println(F("\n===== READY ====="));
  Serial.println(F("Commands (USB or MQTT battery/cmd/load, battery/cmd/sys):"));
  Serial.println(F("  LOAD:<amps>   STOP   CAL   ZERO   CYCLE   SYNC"));
  Serial.println(F("  LIMIT:<amps>|OFF   FAN:<0-100>|AUTO   DEMO_ON   DEMO_OFF"));
  Serial.println(F("==================\n"));

  last_sensor_ms = millis();
  last_control_ms = millis();
}

// ===========================================================================
//  18. MAIN LOOP
// ===========================================================================
void loop() {
  connectWiFi();
  connectMqtt();
  mqtt.loop();

  unsigned long now = millis();

  // ===== CONTROL LOOP (every 200ms) =====
  if (now - last_control_ms >= CONTROL_INTERVAL_MS) {
    last_control_ms = now;
    readCurrentALONE();
    runCurrentControl();
    checkSafetyCutoff();
  }

  // ===== SENSOR + COMPUTE LOOP (every 1000ms) =====
  if (now - last_sensor_ms >= SENSOR_INTERVAL_MS) {
    last_sensor_ms = now;
    // REV B: real time since the previous pass (the pass itself takes >1 s)
    sensor_dt_s = prev_sensor_pass_ms ? (now - prev_sensor_pass_ms) / 1000.0f : 1.0f;
    sensor_dt_s = constrain(sensor_dt_s, 0.2f, 5.0f);
    prev_sensor_pass_ms = now;

    // Temperature read FIRST and ALONE (OneWire settle), per the
    // original noise-isolation fix — still applies on one chip.
    readTemperaturesALONE();   // includes its own 200ms settle delay

    readCurrentALONE();
    delay(20);
    readAmbient();
    delay(10);
    readCellVoltages();
    delay(10);
    readPiezo();
    delay(10);
    readGas();

    updateCoulombCount();
    calculateSOC();
    calculateSOH();
    calculateRUL();
    calculateR0();
    calculateDerived();
    checkFaults();

    float tmax = bat.cell_temp[0];
    for (int i = 1; i < CELL_COUNT; i++) tmax = max(tmax, bat.cell_temp[i]);
    updateFan(tmax);

    checkThresholds();
    if (!demo_mode) aiFeedLocal();      // REV B: on-chip AI on the real pack
    buildOutDoc();

    printState();      // ALWAYS — independent of MQTT
    publishState();     // publishes only if MQTT connected; safe no-op otherwise
  }

  pollUsb();

  // REV B: leave demo mode by itself if the laptop stopped the replay
  if (demo_mode && millis() - last_demo_msg_ms > DEMO_TIMEOUT_MS) {
    Serial.println(F("No replay data for 30 s - leaving demo mode"));
    handleCommand("DEMO_OFF", "timeout");
  }

  if (millis() - lastStats >= 10000) {
    lastStats = millis();
    Serial.printf("[SUMMARY][%s] wifi=%s | mqtt=%s | %s\n",
                  statusText,
                  WiFi.status() == WL_CONNECTED ? "up" : "down",
                  mqtt.connected() ? "up" : "down",
                  warnBuf[0] ? warnBuf : "-");
  }
}
