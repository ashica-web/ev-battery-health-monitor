unsigned long ai_results = 0;
float last_ai_soh = -1.0f;

// ===========================================================================
//  6. LOW-LEVEL HELPERS
// ===========================================================================
void setLoadPwm(int duty) { ledcWrite(MOSFET_PWM_PIN, duty); }

float readPinVolts(int pin) {
  uint32_t acc = 0;
  for (int i = 0; i < ADC_SAMPLES; i++) acc += analogRead(pin);
  float raw = (float)acc / ADC_SAMPLES;
  return (raw / 4095.0f) * 3.3f;
}

int readPinRaw(int pin) {
  uint32_t acc = 0;
  for (int i = 0; i < ADC_SAMPLES; i++) acc += analogRead(pin);
  return (int)(acc / ADC_SAMPLES);
}

float readAdsVolts(uint8_t channel) {
  if (!ads_ok) return 0.0f;
  int32_t acc = 0;
  const int N = 8;
  for (int i = 0; i < N; i++) acc += ads.readADC_SingleEnded(channel);
  int16_t avgRaw = (int16_t)(acc / N);
  return ads.computeVolts(avgRaw);
}

// ===========================================================================
//  7. SENSOR READS (kept phase-isolated — see header note)
// ===========================================================================
void readTemperaturesALONE() {
  tempSensors.requestTemperatures();
  for (int i = 0; i < CELL_COUNT; i++) {
    float t = tempSensors.getTempCByIndex(i);
    if (t != DEVICE_DISCONNECTED_C && t > -50 && t < 150 && t != 85.0f) {
      bat.cell_temp[i] = t;
    }
  }
  delay(200);  // let the OneWire bus / supply rail settle before any ADC read
}

float readCurrentSensorVolts() {
#if CURRENT_VIA_ADS
  return readAdsVolts(ADS_CH_CURRENT) / ACS712_DIV_RATIO;   // REV B: 16-bit path
#else
  return readPinVolts(CURRENT_PIN) / ACS712_DIV_RATIO;
#endif
}

void readCurrentALONE() {
  float v_sensor = readCurrentSensorVolts();
  bat.current_A = (v_sensor - acs712_zero_volts) / ACS712_SENS_V_PER_A * CURRENT_GAIN_TRIM;
  if (fabs(bat.current_A) < 0.05f) bat.current_A = 0.0f;
}

void readAmbient() {
  float t = dht.readTemperature();
  float h = dht.readHumidity();
  if (!isnan(t)) bat.ambient_temp = t;
  if (!isnan(h)) bat.ambient_humidity = h;
}

void readCellVoltages() {
  float v1 = readAdsVolts(ADS_CH_TAP1) * TAP1_FACTOR;
  float v2 = readAdsVolts(ADS_CH_TAP2) * TAP2_FACTOR;
  float v3 = readAdsVolts(ADS_CH_TAP3) * TAP3_FACTOR;
  bat.cell_voltage[0] = v1;
  bat.cell_voltage[1] = v2 - v1;
  bat.cell_voltage[2] = v3 - v2;
  bat.pack_voltage = v3;
}

void readPiezo() {
  bat.piezo_raw[0] = readPinRaw(PIEZO_1_PIN);
  bat.piezo_raw[1] = readPinRaw(PIEZO_2_PIN);
}

void readGas() {
  bat.gas_level = readPinRaw(GAS_PIN);
}

void calibrateCurrentZero() {
  pwm_duty = 0;
  setLoadPwm(0);
  delay(500);
  float sum = 0;
  for (int i = 0; i < 20; i++) {
    sum += readCurrentSensorVolts();
    delay(20);
  }
  acs712_zero_volts = sum / 20.0f;
}

// ===========================================================================
//  8. FAN CONTROL
// ===========================================================================
void updateFan(float tmax) {
  if (fan_override_pct >= 0) {                       // REV B: twin / user override
    fan_duty = (int)(fan_override_pct / 100.0f * FAN_PWM_MAX);
    ledcWrite(FAN_PWM_PIN, fan_duty);
    return;
  }
  if (tmax <= FAN_TEMP_ON) {
    fan_duty = 0;
  } else if (tmax >= FAN_TEMP_FULL) {
    fan_duty = FAN_PWM_MAX;
  } else {
    float frac = (tmax - FAN_TEMP_ON) / (FAN_TEMP_FULL - FAN_TEMP_ON);
    fan_duty = FAN_MIN_DUTY + (int)(frac * (FAN_PWM_MAX - FAN_MIN_DUTY));
  }
  ledcWrite(FAN_PWM_PIN, fan_duty);
}

// ===========================================================================
//  9. CALCULATIONS
// ===========================================================================
void updateCoulombCount() {
  float hours = sensor_dt_s / 3600.0f;          // REV B: measured, not assumed
  float mAh = bat.current_A * 1000.0f * hours;
  coulomb_mAh += mAh;
  if (mAh < 0) cycle_discharge_mAh += -mAh;
}

void calculateSOC() {
  float soc = 100.0f + ((coulomb_mAh / PACK_CAPACITY_MAH) * 100.0f);
  bat.soc_percent = constrain(soc, 0.0f, 100.0f);
  bat.dod_percent = 100.0f - bat.soc_percent;
}

void calculateSOH() {
  bat.soh_percent = constrain((measured_capacity_mAh / baseline_capacity_mAh) * 100.0f, 0.0f, 100.0f);
}

void calculateRUL() {
  float remaining = bat.soh_percent - 80.0f;
  bat.rul_cycles = (remaining <= 0.0f) ? 0.0f : (remaining / 0.05f);
}

void calculateR0() {
  float dI = bat.current_A - prev_current_A;
  if (r0_seeded && fabs(dI) > 0.15f) {
    float dV = bat.pack_voltage - prev_pack_voltage;
    float r0_sample_mohm = fabs((dV / dI) * 1000.0f);
    if (r0_sample_mohm < 2000.0f) {
      if (bat.r0_mohm <= 0.01f) bat.r0_mohm = r0_sample_mohm;
      else bat.r0_mohm = (0.8f * bat.r0_mohm) + (0.2f * r0_sample_mohm);
    }
  }
  prev_current_A = bat.current_A;
  prev_pack_voltage = bat.pack_voltage;
  r0_seeded = true;
}

void calculateDerived() {
  bat.power_W = bat.pack_voltage * fabs(bat.current_A);

  float vmax = bat.cell_voltage[0], vmin = bat.cell_voltage[0];
  float tmax = bat.cell_temp[0], tmin = bat.cell_temp[0];
  for (int i = 1; i < CELL_COUNT; i++) {
    vmax = max(vmax, bat.cell_voltage[i]);
    vmin = min(vmin, bat.cell_voltage[i]);
    tmax = max(tmax, bat.cell_temp[i]);
    tmin = min(tmin, bat.cell_temp[i]);
  }
  bat.cell_imbalance = vmax - vmin;
  bat.thermal_gradient_C = tmax - tmin;

  unsigned long now = millis();
  if (!thermal_seeded) {
    last_max_temp = tmax;
    last_temp_time = now;
    bat.dT_dt = 0.0f;
    thermal_seeded = true;
  } else {
    float dt_s = (now - last_temp_time) / 1000.0f;
    if (dt_s > 0.5f) {
      bat.dT_dt = (tmax - last_max_temp) / dt_s;
      last_max_temp = tmax;
      last_temp_time = now;
    }
  }

  bat.thermal_runaway_risk = 0.0f;
  if (tmax > 45.0f) bat.thermal_runaway_risk += ((tmax - 45.0f) / 15.0f) * 45.0f;
  if (bat.dT_dt > 0.2f) bat.thermal_runaway_risk += ((bat.dT_dt - 0.2f) / 0.8f) * 30.0f;
  if (bat.thermal_gradient_C > 8.0f) bat.thermal_runaway_risk += 15.0f;
  if (bat.cell_imbalance > 0.1f) bat.thermal_runaway_risk += 5.0f;
  if (bat.gas_level > GAS_ALERT_LEVEL) bat.thermal_runaway_risk += 20.0f;
  bat.thermal_runaway_risk = constrain(bat.thermal_runaway_risk, 0.0f, 100.0f);

  float thermal_factor = 1.0f;
  if (tmax > 45.0f) thermal_factor = 1.0f - ((tmax - 45.0f) / 10.0f);
  thermal_factor = constrain(thermal_factor, 0.0f, 1.0f);

  float health_factor = bat.soh_percent / 100.0f;
  bat.continuous_current_limit_A = 2.50f * thermal_factor * health_factor;
  bat.peak_discharge_current_limit_A = 5.00f * thermal_factor * health_factor;
  bat.peak_charge_current_limit_A = 1.25f * thermal_factor * health_factor;

  float nominal_energy = 11.1f * (PACK_CAPACITY_MAH / 1000.0f);
  bat.remaining_energy_Wh = nominal_energy * (bat.soc_percent / 100.0f) * (bat.soh_percent / 100.0f);
  bat.soe_percent = (bat.remaining_energy_Wh / nominal_energy) * 100.0f;
  bat.sof_percent = min(bat.soh_percent, bat.soe_percent);
  bat.sop_percent = bat.continuous_current_limit_A > 0
    ? min(100.0f, (bat.continuous_current_limit_A / fabs(target_current_A + 0.001f)) * 100.0f)
    : 100.0f;

  if (fabs(bat.current_A) > 0.05f) {
    float remaining_Ah = (bat.soc_percent / 100.0f) * (PACK_CAPACITY_MAH / 1000.0f);
    bat.time_to_empty_min = (remaining_Ah / fabs(bat.current_A)) * 60.0f;
    remaining_Ah = ((100.0f - bat.soc_percent) / 100.0f) * (PACK_CAPACITY_MAH / 1000.0f);
    bat.time_to_full_min = (remaining_Ah / fabs(bat.current_A)) * 60.0f;
  } else {
    bat.time_to_empty_min = -1.0f;
    bat.time_to_full_min = -1.0f;
  }

  float hours = sensor_dt_s / 3600.0f;          // REV B: measured, not assumed
  bat.total_energy_throughput_Wh += bat.power_W * hours;
  bat.equivalent_full_cycles = bat.total_energy_throughput_Wh / (2.0f * 11.1f * (PACK_CAPACITY_MAH / 1000.0f));
}

void checkFaults() {
  bat.fault_ov = false;
  bat.fault_uv = false;
  bat.fault_ot = false;
  for (int i = 0; i < CELL_COUNT; i++) {
    if (bat.cell_voltage[i] > CELL_V_MAX) bat.fault_ov = true;
    if (bat.cell_voltage[i] < CELL_V_MIN && bat.cell_voltage[i] > 0.5f) bat.fault_uv = true;
    if (bat.cell_temp[i] > CELL_TEMP_MAX) bat.fault_ot = true;
  }
  bat.fault_gas = (bat.gas_level > GAS_ALERT_LEVEL);
  bat.bms_tripped = bat.fault_ov || bat.fault_uv || bat.fault_ot || bat.fault_gas;
}

// ===========================================================================
//  10. SAFETY CUTOFF — direct and immediate (same chip sees temp AND PWM)
// ===========================================================================
void checkSafetyCutoff() {
  safety_active = false;

  for (int i = 0; i < CELL_COUNT; i++) {
    if (bat.cell_voltage[i] < CELL_V_MIN && bat.cell_voltage[i] > 0.5f) {
      safety_active = true;
      snprintf(safety_reason, sizeof(safety_reason), "cell%d undervoltage %.2f V", i + 1, bat.cell_voltage[i]);
    }
    if (bat.cell_voltage[i] > CELL_V_MAX) {
      safety_active = true;
      snprintf(safety_reason, sizeof(safety_reason), "cell%d overvoltage %.2f V", i + 1, bat.cell_voltage[i]);
    }
    if (bat.cell_temp[i] > CELL_TEMP_MAX) {
      safety_active = true;
      snprintf(safety_reason, sizeof(safety_reason), "cell%d overtemp %.1f C", i + 1, bat.cell_temp[i]);
    }
  }
  if (bat.gas_level > GAS_ALERT_LEVEL) {
    safety_active = true;
    snprintf(safety_reason, sizeof(safety_reason), "gas level %d > %d", bat.gas_level, GAS_ALERT_LEVEL);
  }
  if (bat.dT_dt > TH_DTDT_CRIT) {
    safety_active = true;
    snprintf(safety_reason, sizeof(safety_reason), "dT/dt %.2f C/s", bat.dT_dt);
  }

  if (safety_active) {
    target_current_A = 0.0f;
    pwm_duty = 0;
    setLoadPwm(0);
  }
}

// ===========================================================================
//  11. LOAD CONTROL
// ===========================================================================
void runCurrentControl() {
  // REV B: the digital twin can cap the current (LIMIT:), demo mode forces 0
  float goal = min(target_current_A, current_limit_A);
  if (demo_mode) goal = 0.0f;
  if (goal <= 0.0f) {
    pwm_duty = 0;
    setLoadPwm(0);
    bat.pwm_duty = 0;
    bat.target_current = 0;
    return;
  }

  float actual = fabs(bat.current_A);
  float error = goal - actual;
  int correction = (int)(error * KP_CURRENT);
  correction = constrain(correction, -PWM_STEP_MAX, PWM_STEP_MAX);

  pwm_duty = constrain(pwm_duty + correction, 0, LOAD_PWM_MAX);
  setLoadPwm(pwm_duty);
  bat.pwm_duty = pwm_duty;
  bat.target_current = (int)target_current_A;
}

// REV B: SOC from resting cell voltage (same curve as battery_model.py)
float socFromOcv(float v) {
  const float S[] = {0.00,0.05,0.10,0.15,0.20,0.30,0.40,0.50,0.60,0.70,0.80,0.90,0.95,1.00};
  const float V[] = {3.00,3.35,3.45,3.51,3.55,3.62,3.68,3.74,3.82,3.90,3.99,4.09,4.15,4.20};
  if (v <= V[0]) return 0.0f;
  for (int i = 0; i < 13; i++)
    if (v <= V[i + 1]) return S[i] + (S[i + 1] - S[i]) * (v - V[i]) / (V[i + 1] - V[i]);
  return 1.0f;
}

// ===========================================================================
//  12. COMMANDS — LOAD / STOP / CAL / ZERO / CYCLE, all local now
// ===========================================================================
void handleCommand(String cmd, const char* src) {
  cmd.trim();
  if (cmd.length() == 0) return;
  cmd.toUpperCase();

  Serial.printf("\n>>> CMD from %s: '%s'\n", src, cmd.c_str());

  if (cmd.startsWith("LOAD:")) {
    float amps = cmd.substring(5).toFloat();
    target_current_A = constrain(amps, 0.0f, 5.0f);
    Serial.printf("Target current set to %.2f A\n", target_current_A);
    if (target_current_A > 0.0f && safety_active) {
      Serial.printf("Safety cutoff active: %s -> load forced to 0 A\n", safety_reason);
    }
  }
  else if (cmd.startsWith("STOP")) {
    target_current_A = 0.0f;
    Serial.println(F("Load stopped"));
  }
  else if (cmd.startsWith("CAL")) {
    target_current_A = 0.0f;
    calibrateCurrentZero();
    Serial.printf("ACS712 calibrated: zero = %.4f V\n", acs712_zero_volts);
  }
  else if (cmd.startsWith("ZERO")) {
    coulomb_mAh = 0.0f;
    Serial.println(F("SOC reset to 100%"));
  }
  else if (cmd.startsWith("LIMIT:")) {                 // REV B: twin current cap
    String v = cmd.substring(6);
    if (v == "OFF") current_limit_A = 5.0f;
    else current_limit_A = constrain(v.toFloat(), 0.0f, 5.0f);
    Serial.printf("Current limit now %.2f A%s\n", current_limit_A,
                  current_limit_A >= 5.0f ? " (no limit)" : " - set by digital twin");
  }
  else if (cmd.startsWith("FAN:")) {                   // REV B: fan override
    String v = cmd.substring(4);
    if (v == "AUTO") fan_override_pct = -1;
    else fan_override_pct = constrain((int)v.toFloat(), 0, 100);
    Serial.printf("Fan: %s\n", fan_override_pct < 0 ? "automatic" : String(fan_override_pct).c_str());
  }
  else if (cmd.startsWith("SYNC")) {                   // REV B: SOC from OCV at rest
    float vcell = bat.pack_voltage / CELL_COUNT;
    if (fabs(bat.current_A) < 0.1f && vcell > 2.5f) {
      float soc = socFromOcv(vcell);
      coulomb_mAh = (soc - 1.0f) * PACK_CAPACITY_MAH;
      Serial.printf("SOC synced from %.3f V/cell -> %.1f%%\n", vcell, soc * 100.0f);
    } else {
      Serial.println(F("SYNC needs the pack at rest (no load)"));
    }
  }
  else if (cmd.startsWith("DEMO_ON")) {                // REV B: on-chip AI on replay
    if (!demo_mode) {
      demo_mode = true;
      target_current_A = 0.0f;
      last_demo_msg_ms = millis();
      dis = Discharge();
      if (mqtt.connected()) mqtt.subscribe("battery/state");
      Serial.println(F("DEMO MODE ON - not publishing own readings, AI listens to the laptop"));
    }
  }
  else if (cmd.startsWith("DEMO_OFF")) {
    if (demo_mode) {
      demo_mode = false;
      dis = Discharge();
      // anything the SIMULATED twin set during the demo must not stick
      current_limit_A = 5.0f;
      fan_override_pct = -1;
      if (mqtt.connected()) mqtt.unsubscribe("battery/state");
      Serial.println(F("DEMO MODE OFF - publishing own readings again"));
    }
  }
  else if (cmd.startsWith("CYCLE")) {
    if (cycle_discharge_mAh > 100.0f) {
      measured_capacity_mAh = cycle_discharge_mAh;
      if (bat.cycles_completed == 0) baseline_capacity_mAh = cycle_discharge_mAh;
      bat.cycles_completed++;
      Serial.printf("Cycle %d complete, capacity %.1f mAh\n", bat.cycles_completed, measured_capacity_mAh);
    }
    cycle_discharge_mAh = 0.0f;
  }
}

void pollUsb() {
  while (Serial.available()) {
    char c = (char)Serial.read();
    if (c == '\n' || c == '\r') {
      if (usb_cmd_len > 0) {
        usb_cmd_buf[usb_cmd_len] = '\0';
        handleCommand(String(usb_cmd_buf), "USB");
        usb_cmd_len = 0;
      }
    } else if (usb_cmd_len < 95) {
      usb_cmd_buf[usb_cmd_len++] = c;
    } else {
      usb_cmd_len = 0;
    }
  }
}

// ===========================================================================
//  13. THRESHOLD ENGINE
// ===========================================================================
static inline void escalate(int lvl) { if (lvl > statusLevel) statusLevel = lvl; }
void addWarn(const char* w) {
  if (warnBuf[0] != '\0') strncat(warnBuf, ",", sizeof(warnBuf) - strlen(warnBuf) - 1);
  strncat(warnBuf, w, sizeof(warnBuf) - strlen(warnBuf) - 1);
}
void flag(int lvl, const char* tag) { escalate(lvl); addWarn(tag); }

void checkThresholds() {
  statusLevel = 0;
  warnBuf[0]  = '\0';

  const char* tTags[3] = { "TEMP_C1", "TEMP_C2", "TEMP_C3" };
  for (int i = 0; i < CELL_COUNT; i++) {
    float t = bat.cell_temp[i];
    if (t < -50.0f || t > 200.0f) continue;
    if      (t >= TH_TEMP_CRIT) flag(2, tTags[i]);
    else if (t >= TH_TEMP_WARN) flag(1, tTags[i]);
  }
  if (bat.thermal_gradient_C > TH_GRADIENT_WARN) flag(1, "TEMP_GRADIENT");
  if      (bat.dT_dt >= TH_DTDT_CRIT) flag(2, "DTDT_RUNAWAY");
  else if (bat.dT_dt >= TH_DTDT_WARN) flag(1, "DTDT_RISING");

  const char* vTagU[3] = { "UV_C1", "UV_C2", "UV_C3" };
  const char* vTagO[3] = { "OV_C1", "OV_C2", "OV_C3" };
  for (int i = 0; i < CELL_COUNT; i++) {
    float v = bat.cell_voltage[i];
    if (v < 0.5f) continue;
    if      (v <= TH_CELL_UV_CRIT) flag(2, vTagU[i]);
    else if (v <= TH_CELL_UV_WARN) flag(1, vTagU[i]);
    if      (v >= TH_CELL_OV_CRIT) flag(2, vTagO[i]);
    else if (v >= TH_CELL_OV_WARN) flag(1, vTagO[i]);
  }
  if      (bat.cell_imbalance >= TH_IMBALANCE_CRIT) flag(2, "IMBALANCE");
  else if (bat.cell_imbalance >= TH_IMBALANCE_WARN) flag(1, "IMBALANCE");

  float ic = fabs(bat.current_A);
  if      (ic >= TH_CURRENT_CRIT) flag(2, "OVERCURRENT");
  else if (ic >= TH_CURRENT_WARN) flag(1, "HIGH_CURRENT");

  if      (bat.soc_percent <= TH_SOC_LOW_CRIT) flag(2, "SOC_EMPTY");
  else if (bat.soc_percent <= TH_SOC_LOW_WARN) flag(1, "SOC_LOW");
  if      (bat.soh_percent < TH_SOH_CRIT) flag(2, "SOH_EOL");
  else if (bat.soh_percent < TH_SOH_WARN) flag(1, "SOH_DEGRADED");

  if      (bat.gas_level >= TH_GAS_CRIT) flag(2, "GAS_CRITICAL");
  else if (bat.gas_level >= TH_GAS_WARN) flag(1, "GAS_ELEVATED");

  if      (bat.thermal_runaway_risk >= TH_RISK_CRIT) flag(2, "RUNAWAY_RISK");
  else if (bat.thermal_runaway_risk >= TH_RISK_WARN) flag(1, "RISK_ELEVATED");

  if (bat.bms_tripped) flag(2, "BMS_TRIPPED");
  if (bat.fault_ov)    flag(2, "FAULT_OV");
  if (bat.fault_uv)    flag(2, "FAULT_UV");
  if (bat.fault_ot)    flag(2, "FAULT_OT");
  if (bat.fault_gas)   flag(2, "FAULT_GAS");

  statusText = (statusLevel == 2) ? "CRITICAL" : (statusLevel == 1) ? "WARNING" : "NORMAL";
  if (warnBuf[0] == '\0') strcpy(warnBuf, "NONE");
}

// ===========================================================================
//  13b. EDGE AI (REV B) - same rules as health_inference.py on the laptop
// ===========================================================================
void aiFinishDischarge() {
  unsigned long dur = millis() - dis.start_ms;
  unsigned long needed = dis.replay ? AI_MIN_REPLAY_MS : AI_MIN_REAL_MS;
  dis.active = false;
  if (dur < needed || dis.n_v < 3 || dis.n_t < 3) {
    Serial.printf("[EDGE AI] discharge of %lu s ignored (needs %lu s)\n",
                  dur / 1000, needed / 1000);
    return;
  }
  float values[3] = { (float)(dis.sum_v / dis.n_v), (float)(dis.sum_t / dis.n_t),
                      dis.cycles + 1.0f };
  const char* names[3] = {"voltage", "temperature", "cycle"};
  float x[HM_N_FEATURES];
  for (int j = 0; j < 3; j++) {
    int k = hm_feature_index(names[j]);
    if (k >= 0) x[k] = values[j];
  }
  unsigned long t0 = micros();
  float est = hm_predict(x);
  unsigned long t1 = micros();
  float phi[HM_N_FEATURES], base;
  hm_shap(x, phi, &base);
  unsigned long t2 = micros();

  int in_range = 1;
  for (int j = 0; j < HM_N_FEATURES; j++)
    if (x[j] < HM_RANGE_LO[j] || x[j] > HM_RANGE_HI[j]) in_range = 0;
  int iv = hm_feature_index("voltage"), it = hm_feature_index("temperature"),
      ic = hm_feature_index("cycle");

  char buf[512];
  snprintf(buf, sizeof(buf),
    "{\"est_soh\":%.2f,\"base_soh\":%.2f,"
    "\"shap_voltage\":%.2f,\"shap_temperature\":%.2f,\"shap_cycle\":%.2f,"
    "\"feat_voltage\":%.4f,\"feat_temperature\":%.2f,\"cycle\":%d,"
    "\"infer_us\":%lu,\"explain_ms\":%.1f,\"in_range\":%d,"
    "\"uncertainty_pct\":%.1f,\"source\":\"%s\",\"device\":\"ESP32\"}",
    est * 100.0f, base * 100.0f,
    iv >= 0 ? phi[iv] * 100.0f : 0.0f, it >= 0 ? phi[it] * 100.0f : 0.0f,
    ic >= 0 ? phi[ic] * 100.0f : 0.0f,
    values[0], values[1], (int)values[2],
    t1 - t0, (t2 - t1) / 1000.0f, in_range,
    HM_UNCERTAINTY_PCT, dis.replay ? "replay" : "live");
  if (mqtt.connected()) mqtt.publish("battery/ai_edge", buf, true);
  ai_results++;
  last_ai_soh = est * 100.0f;
  Serial.printf("[EDGE AI] cycle %d: health %.1f%% | estimate %lu us, explanation %.1f ms%s\n",
                (int)values[2], est * 100.0f, t1 - t0, (t2 - t1) / 1000.0f,
                in_range ? "" : " | INPUT OUTSIDE TRAINING RANGE");
}

// One reading into the current discharge. current < 0 = discharging.
void aiAccumulate(float current, float vcell, float tcell, float cycles, bool replay) {
  if (current < -AI_DISCHARGE_A) {
    if (!dis.active) {
      dis = Discharge();
      dis.active = true;
      dis.replay = replay;
      dis.start_ms = millis();
    }
    dis.quiet = 0;
    if (!isnan(vcell)) { dis.sum_v += vcell; dis.n_v++; }
    if (!isnan(tcell)) { dis.sum_t += tcell; dis.n_t++; }
    dis.cycles = cycles;
  } else if (dis.active) {
    if (++dis.quiet >= AI_QUIET_READINGS) aiFinishDischarge();
  }
}

float meanCellVoltage(float c1, float c2, float c3, float pack) {
  float c[3] = {c1, c2, c3};
  float sum = 0; int n = 0;
  for (int i = 0; i < 3; i++) if (c[i] > 2.0f && c[i] < 4.5f) { sum += c[i]; n++; }
  if (n == 3) return sum / 3.0f;
  if (pack > 6.0f && pack < 13.5f) return pack / 3.0f;
  return NAN;
}

float meanCellTemp(float t1, float t2, float t3) {
  float t[3] = {t1, t2, t3};
  float sum = 0; int n = 0;
  for (int i = 0; i < 3; i++) if (t[i] > -40.0f && t[i] < 100.0f) { sum += t[i]; n++; }
  return n ? sum / n : NAN;
}

// Real pack: called once per sensor pass
void aiFeedLocal() {
  aiAccumulate(bat.current_A,
               meanCellVoltage(bat.cell_voltage[0], bat.cell_voltage[1],
                               bat.cell_voltage[2], bat.pack_voltage),
               meanCellTemp(bat.cell_temp[0], bat.cell_temp[1], bat.cell_temp[2]),
               (float)bat.cycles_completed, false);
}

// Demo: replayed NASA data arriving over MQTT
void aiFeedReplay(const String& json) {
  StaticJsonDocument<2048> d;
  if (deserializeJson(d, json)) return;
  const char* src = d["source"] | "";
  if (strcmp(src, "replay") != 0) return;           // only lab replay feeds the AI
  aiAccumulate(d["current_A"] | 0.0f,
               meanCellVoltage(d["cell1_voltage"] | 0.0f, d["cell2_voltage"] | 0.0f,
                               d["cell3_voltage"] | 0.0f, d["pack_voltage"] | 0.0f),
               meanCellTemp(d["cell1_temp"] | -999.0f, d["cell2_temp"] | -999.0f,
                            d["cell3_temp"] | -999.0f),
               d["cycles"] | 0.0f, true);
}

void aiSelfTest() {
  float x[HM_N_FEATURES];
  for (int j = 0; j < HM_N_FEATURES; j++) x[j] = HM_BG[j];   // a new cell
  unsigned long t0 = micros();
  float est = hm_predict(x);
  unsigned long dt = micros() - t0;
  Serial.printf("AI model: %s, %d trees, compiled into this firmware\n", HM_BACKEND, HM_N_TREES);
  Serial.printf("AI self-test: new-cell estimate %.1f%% in %lu us\n", est * 100.0f, dt);
}

// ===========================================================================
//  14. WIFI / MQTT
// ===========================================================================
void connectWiFi() {
  if (WiFi.status() == WL_CONNECTED) return;

  Serial.printf("[WiFi] connecting to '%s'", WIFI_SSID);
  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  for (int i = 0; i < 40 && WiFi.status() != WL_CONNECTED; i++) {
    delay(250);
    Serial.print('.');
  }

  if (WiFi.status() == WL_CONNECTED)
    Serial.printf("\n[WiFi] connected, IP %s\n", WiFi.localIP().toString().c_str());
  else
    Serial.println(F("\n[WiFi] failed — will retry"));
}

void onMqttMessage(char* topic, byte* payload, unsigned int len) {
  String msg;
  msg.reserve(len);
  for (unsigned int i = 0; i < len; i++) msg += (char)payload[i];
  msg.trim();

  // REV B: in demo mode we do not publish battery/state ourselves, so
  // anything arriving on it comes from the laptop (replay / simulator)
  if (!strcmp(topic, "battery/state")) {
    if (demo_mode) {
      last_demo_msg_ms = millis();
      aiFeedReplay(msg);
    }
    return;
  }

  if (!strcmp(topic, "battery/cmd/load")) {
    char cmd[32];
    snprintf(cmd, sizeof(cmd), "LOAD:%s", msg.c_str());
    handleCommand(String(cmd), "MQTT");
    return;
  }
  if (!strcmp(topic, "battery/cmd/sys")) {
    handleCommand(msg, "MQTT");
  }
}

void connectMqtt() {
  if (mqtt.connected() || WiFi.status() != WL_CONNECTED) return;
  if (millis() - lastMqttTry < 5000) return;
  lastMqttTry = millis();

  Serial.printf("[MQTT] connecting to %s:%d ...", MQTT_HOST, MQTT_PORT);

  if (mqtt.connect(MQTT_CLIENTID, NULL, NULL, "battery/online", 0, true, "0")) {
    Serial.println(F(" connected"));
    mqtt.publish("battery/online", "1", true);
    mqtt.subscribe("battery/cmd/load");
    mqtt.subscribe("battery/cmd/sys");
    if (demo_mode) mqtt.subscribe("battery/state");    // REV B
    Serial.println(F("[MQTT] subscribed to command topics"));
  } else {
    Serial.printf(" failed rc=%d — will retry\n", mqtt.state());
  }
}

