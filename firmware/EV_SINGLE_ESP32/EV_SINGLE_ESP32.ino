// ===========================================================================
//  2. PIN MAP
// ===========================================================================
#define DHT_PIN            2
#define ONE_WIRE_BUS       19
#define MOSFET_PWM_PIN     13
#define FAN_PWM_PIN        25   // moved here from gas (digital out — WiFi-safe)
#define CURRENT_PIN        35   // ADC1
#define PIEZO_1_PIN        36   // ADC1
#define PIEZO_2_PIN        39   // ADC1
#define GAS_PIN            34   // ADC1 — moved from GPIO25 (ADC2, unsafe w/ WiFi)

// ADS1115 on the ESP32's default I2C pins
#define ADS1115_I2C_ADDR  0x48
#define ADS1115_SDA       21
#define ADS1115_SCL       22
#define ADS_CH_TAP1        0
#define ADS_CH_TAP2        1
#define ADS_CH_TAP3        2
#define ADS_GAIN  GAIN_ONE      // +-4.096V; power ADS1115 VDD from 5V

// =============== DIVIDER FACTORS ===============
// Tap1: 100k/100k -> 2.0 | Tap2: 220k/100k -> 3.2 | Tap3: 330k/100k -> 4.3
#define TAP1_FACTOR  2.000f
#define TAP2_FACTOR  3.200f
#define TAP3_FACTOR  4.300f

#define ACS712_SENS_V_PER_A  0.066f   // 30A module (confirmed) = 66 mV/A
#define ACS712_DIV_RATIO     0.6875f  // 10k/22k divider. Set 1.0f if the ACS712
                                      // OUT goes straight to ADS1115 A3 (no divider)

// REV B: read the ACS712 through the ADS1115 instead of the ESP32 ADC.
// A 30A sensor on a 1-3A load only moves 66 mV per amp; the ESP32's own
// ADC is too noisy/non-linear for that. The ADS1115 is 16-bit (0.125 mV
// steps at GAIN_ONE) - about 16x finer. Wire ACS712 OUT -> ADS1115 A3
// (the ADS1115 runs from 5V, so the divider is optional), then set 1.
#define CURRENT_VIA_ADS      0
#define ADS_CH_CURRENT       3
// Fine-tune against a multimeter: run 2.0 A by the meter, read the ESP32's
// current, set TRIM = meter / ESP32 (e.g. 2.00 / 1.86 = 1.075)
#define CURRENT_GAIN_TRIM    1.000f

// =============== BATTERY / SAFETY CONSTANTS ===============
#define CELL_COUNT 3
#define PACK_CAPACITY_MAH  3700.0f
#define CELL_V_MAX          4.25f
#define CELL_V_MIN          2.80f
#define CELL_TEMP_MAX       55.0f
#define GAS_ALERT_LEVEL     2500

// Fan curve
const float FAN_TEMP_ON   = 35.0f;
const float FAN_TEMP_FULL = 55.0f;
const int   FAN_MIN_DUTY  = 60;     // bench-tune: lowest duty that spins your fan

// =============== TIMING ===============
#define SENSOR_INTERVAL_MS   1000
#define CONTROL_INTERVAL_MS   200
#define ADC_SAMPLES            64

// =============== PWM ===============
#define LOAD_PWM_FREQ   5000
#define LOAD_PWM_RES_BITS  10
#define LOAD_PWM_MAX     1023
#define FAN_PWM_FREQ    25000
#define FAN_PWM_RES_BITS   8
#define FAN_PWM_MAX      255

#define KP_CURRENT 40.0f
#define PWM_STEP_MAX 25

// ===========================================================================
//  3. THRESHOLDS
// ===========================================================================
const float TH_TEMP_WARN      = 45.0f;
const float TH_TEMP_CRIT      = CELL_TEMP_MAX;
const float TH_GRADIENT_WARN  = 5.0f;
const float TH_DTDT_WARN      = 0.20f;
const float TH_DTDT_CRIT      = 1.00f;

const float TH_CELL_UV_WARN   = 3.00f;
const float TH_CELL_UV_CRIT   = CELL_V_MIN;
const float TH_CELL_OV_WARN   = 4.20f;
const float TH_CELL_OV_CRIT   = CELL_V_MAX;
const float TH_IMBALANCE_WARN = 0.10f;
const float TH_IMBALANCE_CRIT = 0.20f;

const float TH_CURRENT_WARN   = 2.50f;
const float TH_CURRENT_CRIT   = 5.00f;

const float TH_SOC_LOW_WARN   = 15.0f;
const float TH_SOC_LOW_CRIT   = 5.0f;
const float TH_SOH_WARN       = 85.0f;
const float TH_SOH_CRIT       = 80.0f;

const int   TH_GAS_WARN       = 1800;
const int   TH_GAS_CRIT       = GAS_ALERT_LEVEL;

const float TH_RISK_WARN      = 50.0f;
const float TH_RISK_CRIT      = 80.0f;

// ===========================================================================
